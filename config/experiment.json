{
  "$schema": "./schemas/experiment.schema.json",
  "schema_version": "1.0",
  "experiment_id": "terminal-bench-pilot-harness-comparison",
  "description": "Terminal-Bench 4.0 pilot comparison with a fixed OpenRouter model and Daytona execution.",
  "study": {
    "phase": "pilot",
    "scheduled_trials": 330,
    "replications_per_task_harness": 1,
    "analysis_policy": "descriptive_task_and_capability_comparison"
  },
  "toolchain": {
    "harbor_version": "0.22.0",
    "python_min_version": "3.12",
    "node_major": 22,
    "controller_is_system_agnostic": true
  },
  "model": {
    "id": "${MODEL_ID}",
    "id_env": "MODEL_ID",
    "openrouter_provider": "stealth",
    "openrouter_base_url": "https://openrouter.ai/api/v1",
    "reasoning_effort": "max",
    "provider_order": ["stealth"],
    "allow_fallbacks": false,
    "require_parameters": true
  },
  "dataset": {
    "name": "terminal-bench/terminal-bench",
    "ref": "sha256:39d9f44b40420cde8fdcc087579c0d72a7e14fa3656d603c3f0d22fb35e27732",
    "scope": "full",
    "task_names": null
  },
  "execution": {
    "environment": "daytona",
    "attempts": 1,
    "concurrency": 1,
    "max_retries": 0,
    "timeout_multiplier": 1.0,
    "agent_timeout_multiplier": 1.0,
    "verifier_timeout_multiplier": 1.0,
    "environment_build_timeout_multiplier": 1.0,
    "delete_environment_after_trial": true,
    "resources": {
      "cpus": null,
      "memory_mb": null,
      "storage_mb": null,
      "gpus": null
    }
  },
  "prompt_policy": {
    "preserve_task_instruction": true,
    "extra_instructions": [],
    "extra_instruction_paths": []
  },
  "agents": [
    {
      "id": "opencode",
      "harbor_agent": "opencode",
      "version": "1.18.21",
      "model_argument": "openrouter/${MODEL_ID}",
      "reasoning_setting": "model-default-max",
      "native_config": "config/agents/opencode.json"
    },
    {
      "id": "opencode2",
      "harbor_agent": "custom_agents.opencode2:OpenCode2",
      "version": "0.0.0-beta-17927",
      "model_argument": "openrouter/${MODEL_ID}",
      "reasoning_setting": "max",
      "native_config": "config/agents/opencode2.json"
    },
    {
      "id": "codex",
      "harbor_agent": "custom_agents.codex:OpenRouterCodex",
      "version": "0.149.0",
      "model_argument": "${MODEL_ID}",
      "reasoning_setting": "max",
      "native_config": "config/agents/codex.toml"
    },
    {
      "id": "claude-code",
      "harbor_agent": "claude-code",
      "version": "2.1.240",
      "model_argument": "${MODEL_ID}",
      "reasoning_setting": "max",
      "native_config": "config/agents/claude-code.json"
    },
    {
      "id": "pi",
      "harbor_agent": "pi",
      "version": "0.84.2",
      "model_argument": "openrouter/${MODEL_ID}",
      "reasoning_setting": "max",
      "native_reasoning_setting": "xhigh",
      "model_api": "openai-completions",
      "native_config": "config/agents/pi.json"
    }
  ],
  "failure_categories": [
    "agent",
    "model_api",
    "infrastructure",
    "verifier",
    "benchmark"
  ]
}
