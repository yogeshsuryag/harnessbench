{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "dataset", "release", "task_count", "tasks"],
  "properties": {
    "schema_version": {"type": "string"},
    "dataset": {"type": "string"},
    "release": {"const": "v3.0.0"},
    "task_count": {"const": 74},
    "gpu_tasks": {"type": "array", "items": {"type": "string"}},
    "compose_tasks": {"type": "array", "items": {"type": "string"}},
    "sidecar_artifact_tasks": {"type": "array", "items": {"type": "string"}},
    "tasks": {
      "type": "object",
      "minProperties": 74,
      "additionalProperties": {
        "type": "object",
        "required": ["digest", "domain", "subcategory", "coding_relevance", "capabilities"],
        "properties": {
          "digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
          "domain": {"type": "string"},
          "subcategory": {"type": "string"},
          "coding_relevance": {"enum": ["core_swe", "adjacent_engineering", "domain"]},
          "capabilities": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
