{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "experiment_id", "toolchain", "model", "dataset", "execution", "agents", "study"],
  "properties": {
    "schema_version": {"type": "string"},
    "experiment_id": {"type": "string"},
    "study": {
      "type": "object",
      "required": ["phase", "scheduled_trials", "replications_per_task_harness"],
      "properties": {
        "phase": {"const": "pilot"},
        "scheduled_trials": {"const": 330},
        "replications_per_task_harness": {"const": 1},
        "analysis_policy": {"type": "string"}
      }
    },
    "toolchain": {"type": "object"},
    "model": {
      "type": "object",
      "required": ["id", "id_env", "openrouter_provider", "openrouter_base_url", "reasoning_effort", "provider_order", "allow_fallbacks", "require_parameters"],
      "properties": {
        "id": {"pattern": "^\\$\\{MODEL_ID\\}$"},
        "id_env": {"const": "MODEL_ID"},
        "openrouter_provider": {"const": "stealth"},
        "openrouter_base_url": {"const": "https://openrouter.ai/api/v1"},
        "reasoning_effort": {"const": "max"},
        "provider_order": {"const": ["stealth"]},
        "allow_fallbacks": {"const": false},
        "require_parameters": {"const": true}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["name", "ref", "scope"],
      "properties": {
        "name": {"const": "terminal-bench/terminal-bench"},
        "ref": {"const": "sha256:39d9f44b40420cde8fdcc087579c0d72a7e14fa3656d603c3f0d22fb35e27732"},
        "scope": {"const": "full"},
        "task_names": {"const": null}
      }
    },
    "execution": {"type": "object"},
    "prompt_policy": {"type": "object"},
    "agents": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "harbor_agent", "version", "model_argument"],
        "properties": {
          "id": {"type": "string"},
          "harbor_agent": {"type": "string"},
          "version": {"type": "string"},
          "model_argument": {"type": "string", "pattern": "^(\\$\\{MODEL_ID\\}|openrouter/\\$\\{MODEL_ID\\})$"},
          "native_config": {"type": "string"},
          "reasoning_setting": {"type": "string"},
          "native_reasoning_setting": {"type": "string"},
          "model_api": {"type": "string"}
        }
      }
    }
  }
}
