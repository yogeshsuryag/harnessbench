{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "agent_id",
    "task_id",
    "outcome",
    "passed",
    "verifier_valid",
    "failure_category"
  ],
  "properties": {
    "run_id": {"type": ["string", "null"]},
    "agent_id": {"type": ["string", "null"]},
    "agent_version": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "task_name": {"type": ["string", "null"]},
    "task_digest": {"type": ["string", "null"]},
    "domain": {"type": ["string", "null"]},
    "subcategory": {"type": ["string", "null"]},
    "coding_relevance": {"enum": ["core_swe", "adjacent_engineering", "domain", null]},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "outcome": {"enum": ["pass", "task_fail", "graded", "error", "incomplete"]},
    "passed": {"type": ["boolean", "null"]},
    "verifier_valid": {"type": "boolean"},
    "failure_category": {"enum": ["none", "agent", "model_api", "infrastructure", "verifier", "benchmark", "unknown"]},
    "failure_stage": {"type": "string"},
    "primary_reward": {"type": ["number", "null"]},
    "rewards": {"type": ["object", "null"]},
    "input_tokens": {"type": ["integer", "null"]},
    "cached_tokens": {"type": ["integer", "null"]},
    "uncached_input_tokens": {"type": ["integer", "null"]},
    "output_tokens": {"type": ["integer", "null"]},
    "cost_usd": {"type": ["number", "null"]},
    "wall_time_sec": {"type": ["number", "null"]},
    "environment_setup_sec": {"type": ["number", "null"]},
    "agent_setup_sec": {"type": ["number", "null"]},
    "agent_time_sec": {"type": ["number", "null"]},
    "verifier_time_sec": {"type": ["number", "null"]},
    "native_result_path": {"type": ["string", "null"]},
    "trial_directory": {"type": ["string", "null"]},
    "trajectory_path": {"type": ["string", "null"]},
    "trajectory_sha256": {"type": ["string", "null"]},
    "trajectory_steps": {"type": ["integer", "null"]},
    "agent_turns": {"type": ["integer", "null"]},
    "tool_calls": {"type": ["integer", "null"]}
  }
}
